local Players   = game:GetService("Players")
local RunService = game:GetService("RunService")

local player    = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

local LocalAssetCache = {}
local fullModel = nil

pcall(function()
	fullModel = game:GetObjects("rbxassetid://107495486817639")[1]
	if fullModel then fullModel.Parent = workspace end
end)

local function loadAsset(id)
	id = tostring(id):gsub("^rbxassetid://", "")
	if LocalAssetCache[id] then return LocalAssetCache[id] end

	if fullModel then
		local found = fullModel:FindFirstChild(id, true)
		if found then
			LocalAssetCache[id] = found
			return found
		end
	end

	local ok, obj = pcall(function()
		return game:GetObjects("rbxassetid://" .. id)[1]
	end)

	if ok and obj then
		LocalAssetCache[id] = obj
		return obj
	end

	return nil
end

local R6Map = {
	["Head"]      = "Neck",
	["Torso"]     = "RootJoint",
	["Right Arm"] = "Right Shoulder",
	["Left Arm"]  = "Left Shoulder",
	["Right Leg"] = "Right Hip",
	["Left Leg"]  = "Left Hip",
}

local function parseSequence(kfs)
	if typeof(kfs) == "Instance" and not kfs:IsA("KeyframeSequence") then
		for _, obj in ipairs(kfs:GetDescendants()) do
			if obj:IsA("KeyframeSequence") then kfs = obj break end
		end
	end
	assert(kfs and kfs:IsA("KeyframeSequence"), "Expected KeyframeSequence")

	local frames = {}
	for _, frame in ipairs(kfs:GetKeyframes()) do
		local entry = { Time = frame.Time, Poses = {} }
		for _, pose in ipairs(frame:GetDescendants()) do
			if pose:IsA("Pose") and pose.Weight > 0 then
				entry.Poses[pose.Name] = {
					CFrame          = pose.CFrame,
					EasingStyle     = pose.EasingStyle,
					EasingDirection = pose.EasingDirection,
				}
			end
		end
		table.insert(frames, entry)
	end
	table.sort(frames, function(a, b) return a.Time < b.Time end)
	return frames, kfs.Loop
end

local function buildMotorMap(rig)
	local map, lower = {}, {}
	for _, m in ipairs(rig:GetDescendants()) do
		if m:IsA("Motor6D") then
			map[m.Name]            = m
			lower[m.Name:lower()]  = m
		end
	end
	return map, lower
end

local function findMotor(name, map, lower)
	local mapped = R6Map[name] or name
	return map[mapped] or lower[mapped:lower()]
end

local function applyEasing(alpha, style, dir)
	local S, D = Enum.EasingStyle, Enum.EasingDirection
	if style == S.Linear then
		return alpha
	elseif style == S.Sine then
		if dir == D.In  then return 1 - math.cos(alpha * math.pi * 0.5)
		elseif dir == D.Out then return math.sin(alpha * math.pi * 0.5)
		else return -(math.cos(math.pi * alpha) - 1) * 0.5 end
	elseif style == S.Quad then
		if dir == D.In  then return alpha * alpha
		elseif dir == D.Out then return 1 - (1 - alpha)^2
		else return alpha < 0.5 and 2*alpha*alpha or 1-((-2*alpha+2)^2)*0.5 end
	elseif style == S.Cubic then
		if dir == D.In  then return alpha^3
		elseif dir == D.Out then return 1-(1-alpha)^3
		else return alpha < 0.5 and 4*alpha^3 or 1-((-2*alpha+2)^3)*0.5 end
	elseif style == S.Quart then
		if dir == D.In  then return alpha^4
		elseif dir == D.Out then return 1-(1-alpha)^4
		else return alpha < 0.5 and 8*alpha^4 or 1-((-2*alpha+2)^4)*0.5 end
	elseif style == S.Quint then
		if dir == D.In  then return alpha^5
		elseif dir == D.Out then return 1-(1-alpha)^5
		else return alpha < 0.5 and 16*alpha^5 or 1-((-2*alpha+2)^5)*0.5 end
	elseif style == S.Bounce then
		local function bo(t)
			if t < 1/2.75 then return 7.5625*t*t
			elseif t < 2/2.75 then t=t-1.5/2.75 return 7.5625*t*t+0.75
			elseif t < 2.5/2.75 then t=t-2.25/2.75 return 7.5625*t*t+0.9375
			else t=t-2.625/2.75 return 7.5625*t*t+0.984375 end
		end
		if dir == D.Out then return bo(alpha)
		elseif dir == D.In then return 1-bo(1-alpha)
		else return alpha<0.5 and (1-bo(1-2*alpha))*0.5 or (1+bo(2*alpha-1))*0.5 end
	elseif style == S.Back then
		local c = 1.70158
		if dir == D.In then return (c+1)*alpha^3 - c*alpha^2
		elseif dir == D.Out then return 1+(c+1)*(alpha-1)^3+c*(alpha-1)^2
		else
			local c2 = c*1.525
			return alpha<0.5 and ((2*alpha)^2*((c2+1)*2*alpha-c2))*0.5
				or ((2*alpha-2)^2*((c2+1)*(2*alpha-2)+c2)+2)*0.5
		end
	elseif style == S.Elastic then
		local c = (2*math.pi)/3
		if dir == D.In then
			return alpha==0 and 0 or alpha==1 and 1 or -(2^(10*alpha-10))*math.sin((alpha*10-10.75)*c)
		elseif dir == D.Out then
			return alpha==0 and 0 or alpha==1 and 1 or 2^(-10*alpha)*math.sin((alpha*10-0.75)*c)+1
		else
			local c2 = (2*math.pi)/4.5
			return alpha==0 and 0 or alpha==1 and 1 or alpha<0.5
				and -(2^(20*alpha-10)*math.sin((20*alpha-11.125)*c2))*0.5
				or  (2^(-20*alpha+10)*math.sin((20*alpha-11.125)*c2))*0.5+1
		end
	end
	return alpha
end

local AnimPlayer = {}
AnimPlayer.__index = AnimPlayer

function AnimPlayer.new(rig, kfs)
	local self = setmetatable({}, AnimPlayer)
	self.rig               = rig
	self.frames, self.looped = parseSequence(kfs)
	self.map, self.lower   = buildMotorMap(rig)
	self.length            = self.frames[#self.frames].Time
	self.time              = 0
	self.speed             = 1
	self.playing           = false
	return self
end

function AnimPlayer:_sample()
	local prev = self.frames[1]
	local next = self.frames[#self.frames]

	for i = 1, #self.frames - 1 do
		if self.frames[i].Time <= self.time and self.frames[i+1].Time >= self.time then
			prev = self.frames[i]
			next = self.frames[i+1]
			break
		end
	end

	local seg   = next.Time - prev.Time
	local alpha = seg > 0 and (self.time - prev.Time) / seg or 1

	local joints = {}
	for j in pairs(prev.Poses) do joints[j] = true end
	for j in pairs(next.Poses) do joints[j] = true end

	for joint in pairs(joints) do
		local motor = findMotor(joint, self.map, self.lower)
		if motor then
			local pPose = prev.Poses[joint]
			local nPose = next.Poses[joint]
			local cf

			if pPose and nPose then
				local ea = applyEasing(
					alpha,
					nPose.EasingStyle     or Enum.EasingStyle.Cubic,
					nPose.EasingDirection or Enum.EasingDirection.InOut
				)
				cf = pPose.CFrame:Lerp(nPose.CFrame, ea)
			elseif pPose then
				cf = pPose.CFrame
			elseif nPose then
				cf = nPose.CFrame
			end

			if cf then
				-- Write to Transform, not C0.
				-- Transform is what the Roblox Animator uses.
				-- We fire on PreSimulation which runs AFTER the Animator
				-- has written for the frame, so we always override cleanly.
				pcall(function() motor.Transform = cf end)
			end
		end
	end
end

function AnimPlayer:Play(speed, looped)
	if self.playing then return end
	self.playing = true
	self.speed   = speed or 1
	self.looped  = looped == nil and true or looped
	self.time    = 0

	-- PreSimulation fires after PreAnimation (where Animator writes transforms).
	-- Writing here means our values always land last, overriding the Animator
	-- every single frame with zero fighting and zero scratchiness.
	self.conn = RunService.PreSimulation:Connect(function(dt)
		if not self.playing then return end
		self.time += dt * self.speed

		if self.time >= self.length then
			if self.looped then
				self.time = self.time % self.length
			else
				self.time = self.length
				self:_sample()
				self:Stop()
				return
			end
		end

		self:_sample()
	end)
end

function AnimPlayer:Stop()
	self.playing = false
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	-- Reset all transforms to identity.
	-- The Animator immediately takes back over on the next PreAnimation.
	-- Default animations resume with zero extra work.
	for _, motor in pairs(self.map) do
		pcall(function() motor.Transform = CFrame.identity end)
	end
end

local function findKFS(obj)
	if not obj then return nil end
	if obj:IsA("KeyframeSequence") then return obj end
	local kfs = obj:FindFirstChildOfClass("KeyframeSequence")
	if kfs then return kfs end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("KeyframeSequence") then return d end
	end
	return nil
end

getgenv().Animator6D = function(idOrInstance, speed, looped)
	local kfs

	if typeof(idOrInstance) == "Instance" then
		kfs = findKFS(idOrInstance)
	else
		kfs = findKFS(loadAsset(idOrInstance))
	end

	if not kfs then return end

	if getgenv().currentAnimator6D then
		pcall(function() getgenv().currentAnimator6D:Stop() end)
		getgenv().currentAnimator6D = nil
	end

	local anim = AnimPlayer.new(character, kfs)
	getgenv().currentAnimator6D = anim
	anim:Play(speed or 1, looped)
end

getgenv().Animator6DStop = function()
	if getgenv().currentAnimator6D then
		pcall(function() getgenv().currentAnimator6D:Stop() end)
		getgenv().currentAnimator6D = nil
	end
end

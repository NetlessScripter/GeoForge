-- ====================================================================
-- RANDOM EVENT CONFIG
-- ====================================================================
-- Chance is rolled once every CheckInterval seconds. Chance must stay
-- within a 1 in 1,000,000 (0.0001%) to 0.30% range - tune it anywhere
-- in between.
local EVENT_CONFIG = {
	Chance         = 0.003,        -- 0.30% chance per roll (default/max)
	CheckInterval  = 100,            -- seconds between percentage rolls
	OverrideUser   = "Hitmeforgamepass",
	OverridePhrase = "Punishment-Mode",
}

-- Clamp Chance so it can never be set outside the allowed range
EVENT_CONFIG.Chance = math.clamp(EVENT_CONFIG.Chance, 1 / 1000000, 0.003)

local Players         = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local LocalPlayer     = Players.LocalPlayer

local eventTriggered = false

-- ====================================================================
-- THE EVENT ITSELF - asset load, lighting, FPS camera, sprint button,
-- and the final teleport are ALL inside this function. None of it runs
-- until the percentage check succeeds or the override phrase fires.
-- ====================================================================
local function RunEvent()
	if eventTriggered then return end
	eventTriggered = true

	-- ====================================================================
	-- EVENT SOUND
	-- ====================================================================
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://140698715847574"
	sound.Volume = 0.3
	sound.Looped = true
	sound.Parent = workspace
	sound:Play()

	-- ====================================================================
	-- WIPE PLAYERGUI + TOOLS
	-- ====================================================================
	-- Clears everything out of the player's PlayerGui except anything
	-- belonging to TopbarPlus, and "TouchGui" - Roblox's own mobile
	-- thumbstick/jump controls - so mobile players can still move.
	-- (CoreGui is a separate service entirely, so it's untouched either way.)
	local KEEP_GUI_NAMES = {
	    Topbar = true,
	    TouchGui = true,
	}
	local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
	for _, gui in ipairs(PlayerGui:GetChildren()) do
	    local keep = false
	    for name in pairs(KEEP_GUI_NAMES) do
	        if gui.Name:find(name) then
	            keep = true
	            break
	        end
	    end
	    if not keep then
	        gui:Destroy()
	    end
	end

	local Backpack = LocalPlayer:FindFirstChild("Backpack")
	if Backpack then
	    for _, tool in ipairs(Backpack:GetChildren()) do
	        if tool:IsA("Tool") then
	            tool:Destroy()
	        end
	    end
	end

	local eventCharacter = LocalPlayer.Character
	if eventCharacter then
	    for _, tool in ipairs(eventCharacter:GetChildren()) do
	        if tool:IsA("Tool") then
	            tool:Destroy()
	        end
	    end
	end

	-- ====================================================================
	-- ASSET LOAD
	-- ====================================================================
	local id = "rbxassetid://11938076375"

	local success, result = pcall(function()
		return game:GetObjects(id)
	end)

	if success and result and #result > 0 then
		for _, obj in ipairs(result) do
			obj.Parent = workspace
		end
		print("Loaded and parented:", result[1].Name)
	else
		warn("Failed to load asset:", result)
	end

	-- ====================================================================
	-- LIGHTING
	-- ====================================================================
	local l = game:GetService('Lighting')

	-- Wipe every existing lighting effect/instance (old Atmosphere, Sky, Bloom,
	-- ColorCorrection, Clouds, etc.) so our setup below is the only thing active
	for _, child in ipairs(l:GetChildren()) do
		child:Destroy()
	end

	do
		local i = Instance.new('ColorCorrectionEffect')
		i.Brightness = 0.019999999552965164
		i.Contrast = 0.14000000059604645
		i.Saturation = -0.15000000596046448
		i.TintColor = Color3.new(0.8509804606437683, 0.8509804606437683, 0.8509804606437683)
		i.Enabled = true
		i.Parent = l
	end

	do
		local i = Instance.new('BloomEffect')
		i.Intensity = 1
		i.Size = 56
		i.Threshold = 1.6100000143051147
		i.Enabled = true
		i.Parent = l
	end

	do
		local i = Instance.new('Sky')
		i.SkyboxBk = "rbxassetid://6444884337"
		i.SkyboxDn = "rbxassetid://6444884785"
		i.SkyboxFt = "rbxassetid://6444884337"
		i.SkyboxLf = "rbxassetid://6444884337"
		i.SkyboxRt = "rbxassetid://6444884337"
		i.SkyboxUp = "rbxassetid://6412503613"
		i.MoonAngularSize = 11
		i.MoonTextureId = "rbxassetid://6444320592"
		i.SunAngularSize = 11
		i.SunTextureId = "rbxassetid://6196665106"
		i.Parent = l
	end

	do
		local i = Instance.new('Atmosphere')
		i.Density = 0.75
		i.Offset = 0
		i.Color = Color3.new(0.22745098173618317, 0.18431372940540314, 0.15294118225574493)
		i.Decay = Color3.new(0.1882353127002716, 0.12156863510608673, 0.027450982481241226)
		i.Glare = 3.130000114440918
		i.Haze = 10
		i.Parent = l
	end

	l.Brightness = 0
	l.ClockTime = 0
	l.FogEnd = 100000
	l.FogStart = 0
	l.FogColor = Color3.new(0.0941176563501358, 0.0941176563501358, 0.0941176563501358)
	l.OutdoorAmbient = Color3.new(0.04313725605607033, 0.03921568766236305, 0.03921568766236305)
	l.Ambient = Color3.new(0.4156862795352936, 0.3803921639919281, 0.364705890417099)
	l.GlobalShadows = true
	l.GeographicLatitude = 0
	l.EnvironmentSpecularScale = 1
	l.EnvironmentDiffuseScale = 0.4000000059604645
	l.ExposureCompensation = -0.20000000298023224
	l.ColorShift_Bottom = Color3.new(0.5254902243614197, 0.5254902243614197, 0.5254902243614197)
	l.ColorShift_Top = Color3.new(0.4235294461250305, 0.4235294461250305, 0.4235294461250305)
	l.Technology = Enum.Technology.Future
	l.LightingStyle = Enum.LightingStyle.Realistic
	l.ShadowSoftness = 0.3499999940395355
	l.TimeOfDay = "00:00:00"

	-- ====================================================================
	-- FPS CAMERA (ULTIMATE) - includes built-in sprint system
	-- ====================================================================
	local RunService        = game:GetService("RunService")
	local UserInputService  = game:GetService("UserInputService")
	local Camera            = workspace.CurrentCamera
	local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
	local Humanoid          = Character:WaitForChild("Humanoid")
	local Head              = Character:WaitForChild("Head")

	local function hideCharacterBody()
	    for _, part in ipairs(Character:GetDescendants()) do
	        if part:IsA("BasePart") then
	            part.Transparency = 1
	            part.CastShadow = false
	        elseif part:IsA("Decal") then
	            part.Transparency = 1
	        end
	    end
	end

	hideCharacterBody()
	Character.ChildAdded:Connect(function()
	    task.wait(0.1) -- let accessories/clothing finish loading in
	    hideCharacterBody()
	end)

	-- Kill Roblox's default RbxCharacterSounds sounds (Running, Jumping,
	-- Landing, FreeFalling, Splash, Climbing, Swimming, GettingUp, Died)
	-- as soon as they get created under HumanoidRootPart.
	local DEFAULT_SOUND_NAMES = {
	    Running = true,
	    Jumping = true,
	    Landing = true,
	    FreeFalling = true,
	    Splash = true,
	    Climbing = true,
	    Swimming = true,
	    GettingUp = true,
	    Died = true,
	}
	local function killDefaultSound(inst)
	    if inst:IsA("Sound") and DEFAULT_SOUND_NAMES[inst.Name] then
	        inst.Volume = 0
	        inst:Destroy()
	    end
	end
	for _, d in ipairs(Character:GetDescendants()) do
	    killDefaultSound(d)
	end
	Character.DescendantAdded:Connect(killDefaultSound)

	local footstepSound = Instance.new("Sound")
	footstepSound.Name = "Footsteps"
	footstepSound.Parent = HumanoidRootPart

	local CONFIG = {
	    Sensitivity         = 0.13,
	    SensitivityMobile   = 0.20,
	    InvertY             = false,
	    LookMomentum        = 0.82,
	    FOV_Normal          = 60,
	    FOV_Sprint          = 68,
	    FOV_TweenDuration   = 0.35,
	    Bob_Enabled         = true,
	    Bob_WalkAmplitude   = 0.16,
	    Bob_SprintAmplitude = 0.28,
	    Bob_YRatio          = 0.8,
	    Footstep_Enabled       = true,
	    Footstep_SoundIds      = {
	        "rbxassetid://91882016473062",
	        "rbxassetid://114768473003662",
	        "rbxassetid://123224557798023",
	        "rbxassetid://131412978408311",
	    },
	    Footstep_Interval      = 0.45, -- seconds between steps at walk speed
	    Footstep_MinInterval   = 0.24, -- seconds between steps at full sprint speed
	    Footstep_VolumeWalk    = 0.35,
	    Footstep_VolumeSprint  = 0.55,
	    Sway_Enabled        = true,
	    Sway_MouseAmount    = 0.12,
	    Sway_MouseRotation  = 3.5,
	    Sway_MaxRot         = 6.0,
	    Sway_Stiffness      = 14,
	    Sway_Damping        = 6,
	    Sway_MoveAmount     = 0.08,
	    Sway_MoveRotation   = 2.0,
	    Tilt_Enabled        = true,
	    Tilt_Amount         = 2.5,
	    Tilt_Speed          = 10,
	    Shake_LandMag        = 0.06,
	    Shake_LandDuration   = 0.2,
	    Shake_DecaySpeed     = 14,
	    Breathe_Enabled      = true,
	    Breathe_Speed        = 0.7,
	    Breathe_Amount       = 0.012,
	    SprintKey            = Enum.KeyCode.LeftShift,
	    SprintSpeed          = 19,
	    WalkSpeed            = 13,
	    Death_RollAmount     = 25,
	    Death_DropAmount     = -2.5,
	    MaxLookUp            = 80,
	    MaxLookDown          = 80,
	    Energy_Max           = 3,
	    Energy_SprintDrain   = 1,
	    Energy_RegenRate     = 0.4,
	    Energy_SprintMin     = 0.3,
	}
	local State = {
	    Pitch           = 0,
	    Yaw             = 0,
	    PitchVelocity   = 0,
	    YawVelocity     = 0,
	    SwayRot         = Vector2.new(0, 0),
	    SwayVelocity    = Vector2.new(0, 0),
	    SwayMoveRot     = Vector2.new(0, 0),
	    BobTimer        = 0,
	    BobOffset       = Vector3.new(0, 0, 0),
	    BobDirection    = 1,
	    FootstepTimer   = 0,
	    CurrentTilt     = 0,
	    TargetTilt      = 0,
	    ShakeOffset     = Vector3.new(0, 0, 0),
	    ShakeMagnitude  = 0,
	    ShakeTimer      = 0,
	    BreatheTimer    = 0,
	    IsSprinting     = false,
	    IsDead          = false,
	    CurrentFOV      = CONFIG.FOV_Normal,
	    FOVFrom         = CONFIG.FOV_Normal,
	    FOVTo           = CONFIG.FOV_Normal,
	    FOVTweenT       = 1,
	    DeathRoll       = 0,
	    DeathDrop       = 0,
	    PrevVelocityY   = 0,
	    Energy          = 5,
	}
	local function Lerp(a, b, t)
	    return a + (b - a) * t
	end
	local function Clamp(val, min, max)
	    return math.max(min, math.min(max, val))
	end
	local FPSCamera = {}
	local function TriggerShake(magnitude, duration)
	    State.ShakeMagnitude = math.max(State.ShakeMagnitude, magnitude)
	    State.ShakeTimer     = math.max(State.ShakeTimer, duration)
	end
	function FPSCamera:GetIsSprinting() return State.IsSprinting end
	function FPSCamera:GetPitch()      return State.Pitch       end
	function FPSCamera:GetYaw()        return State.Yaw         end
	_G.FPSCamera = FPSCamera

	-- Energy/stamina cooldown logic kept intact, no visible bar
	local function updateEnergyBar()
	end

	local function canSprint()
	    return State.Energy > CONFIG.Energy_SprintMin
	end

	Camera.CameraType = Enum.CameraType.Scriptable
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false
	local IsMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

	local mouseDeltaX = 0
	local mouseDeltaY = 0

	if IsMobile then
	    local ScreenGui = Instance.new("ScreenGui")
	    ScreenGui.Name = "FPSMobileUI"
	    ScreenGui.ResetOnSpawn = false
	    ScreenGui.IgnoreGuiInset = true
	    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	    ScreenGui.Parent = LocalPlayer.PlayerGui

	    local lookZone = Instance.new("Frame")
	    lookZone.Size = UDim2.fromScale(0.55, 1)
	    lookZone.Position = UDim2.fromScale(0.45, 0)
	    lookZone.BackgroundTransparency = 1
	    lookZone.ZIndex = 1
	    lookZone.Parent = ScreenGui

	    local lookTouch = nil
	    local lookLastPos = nil

	    lookZone.InputBegan:Connect(function(input)
	        if input.UserInputType == Enum.UserInputType.Touch and lookTouch == nil then
	            lookTouch   = input
	            lookLastPos = input.Position
	        end
	    end)

	    lookZone.InputChanged:Connect(function(input)
	        if input == lookTouch and lookLastPos then
	            local delta = input.Position - lookLastPos
	            mouseDeltaX = delta.X
	            mouseDeltaY = delta.Y
	            lookLastPos = input.Position
	        end
	    end)

	    lookZone.InputEnded:Connect(function(input)
	        if input == lookTouch then
	            lookTouch   = nil
	            lookLastPos = nil
	        end
	    end)

		local sprintBtn = Instance.new("ImageButton")
	sprintBtn.Name = "SprintButton"
	sprintBtn.Size = UDim2.new(0, 80, 0, 80)
	sprintBtn.Position = UDim2.new(0, 20, 0.72, 0)
	sprintBtn.BackgroundTransparency = 1

	do
	    local iconPath = "SprintIcon.png"
	    local iconUrl = "https://raw.githubusercontent.com/NetlessScripter/Texture-Reworks/refs/heads/main/IMG_3612.png"
	    if not isfile(iconPath) then
	        writefile(iconPath, game:HttpGet(iconUrl))
	    end
	    sprintBtn.Image = getcustomasset(iconPath)
	end

	sprintBtn.ZIndex = 2
	sprintBtn.Parent = ScreenGui

	sprintBtn.MouseButton1Click:Connect(function()
	    if not canSprint() then return end
	    State.IsSprinting = not State.IsSprinting
	end)
	else
	    UserInputService.InputChanged:Connect(function(input)
	        if input.UserInputType == Enum.UserInputType.MouseMovement then
	            mouseDeltaX = input.Delta.X
	            mouseDeltaY = input.Delta.Y
	        end
	    end)

	    UserInputService.InputBegan:Connect(function(input, gpe)
	        if gpe then return end
	        if input.KeyCode == CONFIG.SprintKey then
	            if canSprint() then
	                State.IsSprinting = true
	            end
	        end
	    end)

	    UserInputService.InputEnded:Connect(function(input)
	        if input.KeyCode == CONFIG.SprintKey then
	            State.IsSprinting = false
	        end
	    end)
	end
	Humanoid.Died:Connect(function()
	    State.IsDead = true
	    if not IsMobile then
	        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	        UserInputService.MouseIconEnabled = true
	    end
	    local t = 0
	    local rollDir = math.random() > 0.5 and 1 or -1
	    RunService:BindToRenderStep("FPS_Death", Enum.RenderPriority.Camera.Value + 2, function(dt)
	        t = t + dt
	        State.DeathRoll = Lerp(State.DeathRoll, CONFIG.Death_RollAmount * rollDir, dt * 4)
	        State.DeathDrop = Lerp(State.DeathDrop, CONFIG.Death_DropAmount, dt * 3)
	    end)
	end)
	RunService.Heartbeat:Connect(function(dt)
	    local vel = HumanoidRootPart.AssemblyLinearVelocity
	    local velY = vel.Y
	    if State.PrevVelocityY < -20 and velY > -5 and Humanoid.FloorMaterial ~= Enum.Material.Air then
	        local impact = math.abs(State.PrevVelocityY)
	        local mag = Clamp(impact / 80, 0, 1) * CONFIG.Shake_LandMag * 2 + CONFIG.Shake_LandMag
	        TriggerShake(mag, CONFIG.Shake_LandDuration)
	    end
	    if State.IsSprinting then
	        State.Energy = math.max(0, State.Energy - CONFIG.Energy_SprintDrain * dt)
	        if State.Energy <= CONFIG.Energy_SprintMin then
	            State.IsSprinting = false
	        end
	    else
	        State.Energy = math.min(CONFIG.Energy_Max, State.Energy + CONFIG.Energy_RegenRate * dt)
	    end
	    -- Set every heartbeat (not just on toggle) so this always wins over
	    -- anything else that tries to touch WalkSpeed.
	    Humanoid.WalkSpeed = State.IsSprinting and CONFIG.SprintSpeed or CONFIG.WalkSpeed
	    updateEnergyBar()
	    State.PrevVelocityY = velY
	end)
	RunService:BindToRenderStep("FPS_Camera_Main", Enum.RenderPriority.Camera.Value + 1, function(dt)
	    if State.IsDead then return end
	    dt = math.min(dt, 0.05)
	    local sens = IsMobile and CONFIG.SensitivityMobile or CONFIG.Sensitivity
	    local dX = mouseDeltaX * sens
	    local dY = mouseDeltaY * sens * (CONFIG.InvertY and -1 or 1)
	    mouseDeltaX = 0
	    mouseDeltaY = 0
	    State.YawVelocity   = State.YawVelocity   * CONFIG.LookMomentum - dX
	    State.PitchVelocity = State.PitchVelocity * CONFIG.LookMomentum - dY
	    State.Yaw   = State.Yaw   + State.YawVelocity
	    State.Pitch = Clamp(State.Pitch + State.PitchVelocity, -CONFIG.MaxLookDown, CONFIG.MaxLookUp)
	    local rootCF  = HumanoidRootPart.CFrame
	    local headPos = Head.Position
	    local camOrigin = CFrame.new(headPos + Vector3.new(0, 0.3, 0))
	    local rotYaw   = CFrame.Angles(0, math.rad(State.Yaw), 0)
	    local rotPitch = CFrame.Angles(math.rad(State.Pitch), 0, 0)
	    local baseCF = camOrigin * rotYaw * rotPitch
	    local bobOffset = Vector3.new(0, 0, 0)
	    local vel = HumanoidRootPart.AssemblyLinearVelocity
	    local speed = Vector2.new(vel.X, vel.Z).Magnitude
	    local grounded = Humanoid.FloorMaterial ~= Enum.Material.Air

	    if speed > 0.5 and grounded then
	        local speedRatio = Clamp(speed / CONFIG.SprintSpeed, 0, 1)
	        local interval = Lerp(CONFIG.Footstep_Interval, CONFIG.Footstep_MinInterval, speedRatio)
	        State.FootstepTimer = State.FootstepTimer + dt

	        if CONFIG.Bob_Enabled then
	            local bobAmp = State.IsSprinting and CONFIG.Bob_SprintAmplitude or CONFIG.Bob_WalkAmplitude
	            local progress = Clamp(State.FootstepTimer / interval, 0, 1)
	            local bY = -math.sin(progress * math.pi) * bobAmp * CONFIG.Bob_YRatio
	            local bX = math.cos(progress * math.pi) * bobAmp * 0.5 * State.BobDirection
	            State.BobOffset = Vector3.new(bX, bY, 0)
	        end

	        if State.FootstepTimer >= interval then
	            State.FootstepTimer = 0
	            State.BobDirection = -State.BobDirection
	            if CONFIG.Footstep_Enabled then
	                footstepSound.SoundId = CONFIG.Footstep_SoundIds[math.random(1, #CONFIG.Footstep_SoundIds)]
	                footstepSound.PlaybackSpeed = Lerp(0.9, 1.2, speedRatio) + (math.random() * 0.1 - 0.05)
	                footstepSound.Volume = Lerp(CONFIG.Footstep_VolumeWalk, CONFIG.Footstep_VolumeSprint, speedRatio)
	                footstepSound:Play()
	            end
	        end
	    else
	        State.BobOffset = State.BobOffset:Lerp(Vector3.new(0, 0, 0), dt * 8)
	        State.FootstepTimer = CONFIG.Footstep_Interval
	    end

	    if CONFIG.Bob_Enabled then
	        bobOffset = State.BobOffset
	    end
	    local swayRot = CFrame.identity
	    if CONFIG.Sway_Enabled then
	        local mouseSwayTarget = Vector2.new(
	            Clamp(-dX * CONFIG.Sway_MouseAmount, -CONFIG.Sway_MaxRot, CONFIG.Sway_MaxRot),
	            Clamp(-dY * CONFIG.Sway_MouseAmount, -CONFIG.Sway_MaxRot, CONFIG.Sway_MaxRot)
	        )
	        local springForceX = (mouseSwayTarget.X - State.SwayRot.X) * CONFIG.Sway_Stiffness
	        local springForceY = (mouseSwayTarget.Y - State.SwayRot.Y) * CONFIG.Sway_Stiffness
	        State.SwayVelocity = Vector2.new(
	            State.SwayVelocity.X + (springForceX - State.SwayVelocity.X * CONFIG.Sway_Damping) * dt,
	            State.SwayVelocity.Y + (springForceY - State.SwayVelocity.Y * CONFIG.Sway_Damping) * dt
	        )
	        State.SwayRot = Vector2.new(
	            Clamp(State.SwayRot.X + State.SwayVelocity.X * dt, -CONFIG.Sway_MaxRot, CONFIG.Sway_MaxRot),
	            Clamp(State.SwayRot.Y + State.SwayVelocity.Y * dt, -CONFIG.Sway_MaxRot, CONFIG.Sway_MaxRot)
	        )
	        local vel = HumanoidRootPart.AssemblyLinearVelocity
	        local right   = HumanoidRootPart.CFrame.RightVector
	        local forward = HumanoidRootPart.CFrame.LookVector
	        local strafeAmt  = Clamp(vel:Dot(right)   / 20, -1, 1) * CONFIG.Sway_MoveAmount
	        local forwardAmt = Clamp(vel:Dot(forward)  / 20, -1, 1) * CONFIG.Sway_MoveAmount
	        State.SwayMoveRot = Vector2.new(
	            Lerp(State.SwayMoveRot.X, strafeAmt,  dt * 6),
	            Lerp(State.SwayMoveRot.Y, forwardAmt, dt * 6)
	        )
	        local totalSwayYaw   = State.SwayRot.X * CONFIG.Sway_MouseRotation + State.SwayMoveRot.X * CONFIG.Sway_MoveRotation
	        local totalSwayPitch = State.SwayRot.Y * CONFIG.Sway_MouseRotation + State.SwayMoveRot.Y * CONFIG.Sway_MoveRotation
	        local totalSwayRoll  = State.SwayRot.X * CONFIG.Sway_MouseRotation * 0.5
	        swayRot = CFrame.Angles(
	            math.rad(totalSwayPitch),
	            math.rad(totalSwayYaw),
	            math.rad(totalSwayRoll)
	        )
	    end
	    local tiltAngle = 0
	    if CONFIG.Tilt_Enabled then
	        local vel = HumanoidRootPart.AssemblyLinearVelocity
	        local rightVec = rootCF.RightVector
	        local strafeDot = vel:Dot(rightVec)
	        local maxVel = 16
	        local normalizedStrafe = Clamp(strafeDot / maxVel, -1, 1)
	        State.TargetTilt = -normalizedStrafe * CONFIG.Tilt_Amount
	        State.CurrentTilt = Lerp(State.CurrentTilt, State.TargetTilt, dt * CONFIG.Tilt_Speed)
	        tiltAngle = State.CurrentTilt
	    end
	    local shakeOffset = Vector3.new(0, 0, 0)
	    if State.ShakeTimer > 0 then
	        State.ShakeTimer = State.ShakeTimer - dt
	        local progress = State.ShakeTimer / 0.3
	        local intensity = State.ShakeMagnitude * math.max(0, progress)
	        shakeOffset = Vector3.new(
	            (math.random() * 2 - 1) * intensity,
	            (math.random() * 2 - 1) * intensity,
	            0
	        )
	        if State.ShakeTimer <= 0 then
	            State.ShakeMagnitude = 0
	        end
	    end
	    State.ShakeOffset = State.ShakeOffset:Lerp(shakeOffset, dt * CONFIG.Shake_DecaySpeed)
	    local breatheOffset = Vector3.new(0, 0, 0)
	    if CONFIG.Breathe_Enabled then
	        State.BreatheTimer = State.BreatheTimer + dt * CONFIG.Breathe_Speed
	        local bx = math.sin(State.BreatheTimer * 0.9) * CONFIG.Breathe_Amount
	        local by = math.sin(State.BreatheTimer * 1.1) * CONFIG.Breathe_Amount * 0.5
	        breatheOffset = Vector3.new(bx, by, 0)
	    end
	    local targetFOV = State.IsSprinting and CONFIG.FOV_Sprint or CONFIG.FOV_Normal
	    if targetFOV ~= State.FOVTo then
	        State.FOVFrom = State.CurrentFOV
	        State.FOVTo = targetFOV
	        State.FOVTweenT = 0
	    end
	    State.FOVTweenT = math.min(1, State.FOVTweenT + dt / CONFIG.FOV_TweenDuration)
	    local easedT = 1 - (1 - State.FOVTweenT) ^ 3 -- ease-out cubic
	    State.CurrentFOV = Lerp(State.FOVFrom, State.FOVTo, easedT)
	    Camera.FieldOfView = State.CurrentFOV
	    local totalRoll = tiltAngle + State.DeathRoll
	    local totalPosOffset = bobOffset + State.ShakeOffset + breatheOffset
	    local finalCF = baseCF
	        * swayRot
	        * CFrame.Angles(0, 0, math.rad(totalRoll))
	        * CFrame.new(totalPosOffset)
	    Camera.CFrame = finalCF
	    HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position)
	        * CFrame.Angles(0, math.rad(State.Yaw), 0)
	end)

	-- ====================================================================
	-- TELEPORT TO SPAWN POINT (runs once, after everything above has loaded)
	-- ====================================================================
	do
	    local targetOk, target = pcall(function()
	        return workspace:WaitForChild("Level0"):WaitForChild("0"):WaitForChild("Ben's Chair")
	    end)

	    if targetOk and target then
	        local teleportCFrame
	        if target:IsA("BasePart") then
	            teleportCFrame = target.CFrame
	        elseif target:IsA("Model") then
	            teleportCFrame = target.PrimaryPart and target.PrimaryPart.CFrame or target:GetPivot()
	        end

	        if teleportCFrame then
	            HumanoidRootPart.CFrame = teleportCFrame + Vector3.new(0, 3, 0)
	        else
	            warn("Ben's Chair found but isn't a Part or Model with a usable position")
	        end
	    else
	        warn("Could not find workspace.Level0.0.\"Ben's Chair\":", target)
	    end
	end
end

-- ====================================================================
-- OVERRIDE: if Hitmeforgamepass types "Punishment-Mode" in chat, the
-- event above fires instantly, skipping the percentage checks and any
-- wait - straight to teleport + everything else.
-- ====================================================================
TextChatService.MessageReceived:Connect(function(message)
	if eventTriggered then return end

	local sender = message.TextSource
	if not sender then return end

	local player = Players:GetPlayerByUserId(sender.UserId)
	if player and player.Name == EVENT_CONFIG.OverrideUser and message.Text == EVENT_CONFIG.OverridePhrase then
		RunEvent()
	end
end)

-- ====================================================================
-- PERCENTAGE CHECK LOOP - rolls the dice once every second, forever,
-- until the event has fired (it only ever fires once).
-- ====================================================================
task.spawn(function()
	while not eventTriggered do
		task.wait(EVENT_CONFIG.CheckInterval)
		if eventTriggered then break end
		if math.random() <= EVENT_CONFIG.Chance then
			RunEvent()
		end
	end
end)

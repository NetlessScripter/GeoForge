do
    local function sgs(n) local ok,s=pcall(game.GetService,game,n) return ok and s or nil end
    local cs,rs,players,lg,us,TS = sgs("CollectionService"), sgs("RunService"), sgs("Players"), sgs("Lighting"), sgs("UserInputService"), sgs("TweenService")
    if not cs or not rs or not players or not TS then warn("PerfMaster: missing services") return end
    local ugs; pcall(function() ugs = UserSettings():GetService("UserGameSettings") end)
    local plr = players.LocalPlayer or players:WaitForChild("LocalPlayer",5)
    local function cam() return workspace.CurrentCamera or workspace:FindFirstChildWhichIsA("Camera") end

    local TAG = "PerfCull"
    local BASE_STEP = 12
    local BATCH_WAIT_MIN = 0.00045
    local BATCH_WAIT_MAX = 0.006
    local RD_DESKTOP, RD_MOBILE, RD_MIN = 3000,1200,240
    local LOD_D_DESKTOP, LOD_D_MOBILE = 880,560
    local OCC_INTERVAL_LOW, OCC_INTERVAL_HIGH = 1.3,0.22
    local FPS_SAMPLE = 0.8
    local TARGET_DESKTOP, TARGET_MOBILE = 140,60
    local ADAPT = 0.90
    local PARTICLE_MAX_DESKTOP, PARTICLE_MAX_MOBILE = 48,16
    local PARTICLE_DISABLE_D_DESKTOP, PARTICLE_DISABLE_D_MOBILE = 1800,800
    local SOUND_DISABLE_D_DESKTOP, SOUND_DISABLE_D_MOBILE = 1800,800
    local DECAL_DISABLE_D_DESKTOP, DECAL_DISABLE_D_MOBILE = 1600,700
    local LIGHT_DISABLE_D_DESKTOP, LIGHT_DISABLE_D_MOBILE = 2000,800
    local SHADOWS_OFF_IF_FPS_BELOW = 48
    local WARMUP_S = 1.0
    local FADE_SHORT, FADE_LONG = 0.06,0.12
    local UI_SAVE_KEY = "PerfModeEnabled"
    local MAX_RAYCASTS_PER_FRAME = 5
    local MAX_TWEENS_ACTIVE = 10
    local INSTANT_FADE_PART_COUNT = 28
    local WORKER_POOL = 4
    local AWARDMODE_RD_SCALE = 0.45
    local PANIC_FPS = 20

    local cache = setmetatable({}, { __mode = "k" })
    local list = {}
    local rd = RD_DESKTOP
    local rd2 = rd*rd
    local LOD_D = LOD_D_DESKTOP
    local LOD_D2 = LOD_D*LOD_D
    local particleMax = PARTICLE_MAX_DESKTOP
    local particleDisableD = PARTICLE_DISABLE_D_DESKTOP
    local soundDisableD = SOUND_DISABLE_D_DESKTOP
    local decalDisableD = DECAL_DISABLE_D_DESKTOP
    local lightDisableD = LIGHT_DISABLE_D_DESKTOP
    local TARGET = TARGET_DESKTOP
    local occInterval = OCC_INTERVAL_HIGH
    local step = BASE_STEP
    local lastSample = tick()
    local frameCount = 0
    local avgFPS = TARGET_DESKTOP
    local perfOn = true
    local debugLog = false
    local activeTweens = 0
    local raycastsLeft = MAX_RAYCASTS_PER_FRAME
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist

    local awardMode = false
    local panicMode = false

    local pool = {}
    local function alloc()
        return table.remove(pool) or {}
    end
    local function free(t)
        for k in pairs(t) do t[k] = nil end
        pool[#pool+1] = t
    end

    local function sqrmag(a,b)
        local dx = a.X-b.X; local dy = a.Y-b.Y; local dz = a.Z-b.Z
        return dx*dx+dy*dy+dz*dz
    end

    local function detectPlatform()
        local isTouch = false
        pcall(function() isTouch = us and us.TouchEnabled end)
        if isTouch then
            TARGET = TARGET_MOBILE
            rd = RD_MOBILE
            LOD_D = LOD_D_MOBILE
            particleMax = PARTICLE_MAX_MOBILE
            particleDisableD = PARTICLE_DISABLE_D_MOBILE
            soundDisableD = SOUND_DISABLE_D_MOBILE
            decalDisableD = DECAL_DISABLE_D_MOBILE
            lightDisableD = LIGHT_DISABLE_D_MOBILE
            occInterval = OCC_INTERVAL_LOW
            return "mobile"
        else
            TARGET = TARGET_DESKTOP
            rd = RD_DESKTOP
            LOD_D = LOD_D_DESKTOP
            particleMax = PARTICLE_MAX_DESKTOP
            particleDisableD = PARTICLE_DISABLE_D_DESKTOP
            soundDisableD = SOUND_DISABLE_D_DESKTOP
            decalDisableD = DECAL_DISABLE_D_DESKTOP
            lightDisableD = LIGHT_DISABLE_D_DESKTOP
            occInterval = OCC_INTERVAL_HIGH
            return "desktop"
        end
    end

    local function mkc(m)
        if not m or not m.Parent or cache[m] then return end
        local ok,desc = pcall(function() return m:GetDescendants() end)
        if not ok then desc = {} end
        local t = { parts = {}, emit = {}, sounds = {}, decals = {}, lights = {}, guis = {}, lowDesc = nil, highDesc = nil, lastOc = 0, oc = false, lastD = 1e9, lod = "high", partCount = 0, freq = 0, ticket = 0, prim = nil }
        local pc = 0
        for i=1,#desc do
            local v = desc[i]
            if type(v) == "Instance" then
                if v:IsA("BasePart") then pc = pc + 1; t.parts[v] = v.LocalTransparencyModifier or 0 end
                if v:IsA("ParticleEmitter") then t.emit[v] = { on = v.Enabled, rate = v.Rate or 0 } end
                if v:IsA("Sound") then t.sounds[v] = { on = v.Playing, vol = v.Volume or 1 } end
                if v.ClassName == "Decal" or v.ClassName == "Texture" then t.decals[v] = v.Transparency or 0 end
                if v:IsA("Light") then t.lights[v] = v.Enabled end
                if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then t.guis[v] = v.Enabled end
            end
        end
        t.partCount = pc
        local okLow, low = pcall(function() return m:FindFirstChild("LOD_LOW") end)
        t.lowDesc = okLow and low and low:GetDescendants() or nil
        local okHigh, high = pcall(function() return m:FindFirstChild("LOD_HIGH") end)
        t.highDesc = okHigh and high and high:GetDescendants() or nil
        local okPrim, p = pcall(function() return m.PrimaryPart end)
        if okPrim and p then t.prim = p else t.prim = m:FindFirstChildWhichIsA("BasePart") end
        cache[m] = t
    end

    local function clean(m) cache[m] = nil end

    local function safeTween(p,to,fast)
        if not p or not p.Parent then return end
        if activeTweens >= MAX_TWEENS_ACTIVE then p.LocalTransparencyModifier = to; return end
        local info = TweenInfo.new(fast and FADE_SHORT or FADE_LONG, Enum.EasingStyle.Linear)
        local ok, tw = pcall(function() return TS:Create(p, info, { LocalTransparencyModifier = to }) end)
        if not ok or not tw then p.LocalTransparencyModifier = to; return end
        activeTweens = activeTweens + 1
        tw.Completed:Connect(function() activeTweens = math.max(0, activeTweens - 1) end)
        pcall(function() tw:Play() end)
    end

    local function doHideHigh(m,t)
        if not t then return end
        local instant = (t.partCount and t.partCount > INSTANT_FADE_PART_COUNT)
        for p,_ in pairs(t.parts) do if p and p.Parent then if instant then p.LocalTransparencyModifier = 1 else safeTween(p,1,true) end end end
        for e,_ in pairs(t.emit) do if e and e.Parent then e.Enabled = false end end
        for s,_ in pairs(t.sounds) do if s and s.Parent then s.Playing = false end end
        for d,_ in pairs(t.decals) do if d and d.Parent then d.Transparency = 1 end end
        for l,_ in pairs(t.lights) do if l and l.Parent then l.Enabled = false end end
        for g,_ in pairs(t.guis) do if g and g.Parent then g.Enabled = false end end
        if t.lowDesc and t.highDesc then
            for i=1,#t.lowDesc do local v=t.lowDesc[i] if v:IsA("BasePart") then v.LocalTransparencyModifier = 0 end; if v:IsA("ParticleEmitter") then v.Enabled = true end end
            for i=1,#t.highDesc do local v=t.highDesc[i] if v:IsA("BasePart") then if instant then v.LocalTransparencyModifier = 1 else safeTween(v,1,true) end end; if v:IsA("ParticleEmitter") then v.Enabled = false end end
            t.lod = "low"; return
        end
        t.lod = "hidden"
    end

    local function doShowHigh(m,t)
        if not t then return end
        local instant = (t.partCount and t.partCount > INSTANT_FADE_PART_COUNT)
        for p,old in pairs(t.parts) do if p and p.Parent then if instant then p.LocalTransparencyModifier = old else safeTween(p,old,true) end end end
        for e,old in pairs(t.emit) do if e and e.Parent then e.Enabled = old.on end end
        for s,old in pairs(t.sounds) do if s and s.Parent then s.Playing = old.on; s.Volume = old.vol end end
        for d,old in pairs(t.decals) do if d and d.Parent then d.Transparency = old end end
        for l,old in pairs(t.lights) do if l and l.Parent then l.Enabled = old end end
        for g,old in pairs(t.guis) do if g and g.Parent then g.Enabled = old end end
        if t.lowDesc and t.highDesc then
            for i=1,#t.lowDesc do local v=t.lowDesc[i] if v:IsA("BasePart") then v.LocalTransparencyModifier = 1 end; if v:IsA("ParticleEmitter") then v.Enabled = false end end
            for i=1,#t.highDesc do local v=t.highDesc[i] if v:IsA("BasePart") then if instant then v.LocalTransparencyModifier = 0 else safeTween(v,0,true) end end; if v:IsA("ParticleEmitter") then v.Enabled = true end end
            t.lod = "high"; return
        end
        t.lod = "shown"
    end

    local function inView(pos)
        local c = cam()
        if not c then return true end
        local ok,x,y,on = pcall(function() return c:WorldToViewportPoint(pos) end)
        return ok and on
    end

    local function cheapOccl(m,t,prim,camPos)
        if not t or not prim then return false end
        local now = tick()
        if now - t.lastOc < occInterval then return t.oc end
        t.lastOc = now
        local c = cam()
        if not c then t.oc = false; return false end
        if not inView(prim.Position) then t.oc = true; return true end
        if raycastsLeft <= 0 then t.oc = false; return false end
        raycastsLeft = raycastsLeft - 1
        local ok, r = pcall(function() return workspace:Raycast(c.CFrame.Position, prim.Position - c.CFrame.Position, rayParams) end)
        if not ok then t.oc = false; return false end
        t.oc = not (r and r.Instance and r.Instance:IsDescendantOf(m))
        return t.oc
    end

    local function applyBudget(t,d)
        if not t then return end
        for e,data in pairs(t.emit) do if e and e.Parent then if d > particleDisableD then e.Enabled = false else e.Enabled = data.on; if e.Rate and e.Rate > particleMax then e.Rate = particleMax end end end end
        for s,data in pairs(t.sounds) do if s and s.Parent then if d > soundDisableD then s.Playing = false else s.Playing = data.on; if s.Volume and s.Volume > 1 then s.Volume = 1 end end end end
        for dec,old in pairs(t.decals) do if dec and dec.Parent then local ok,cp = pcall(function() return cam().CFrame.Position end); if ok then local pd = sqrmag(cp, dec.Parent.Position); if pd > decalDisableD*decalDisableD then dec.Transparency = 1 else dec.Transparency = old end else dec.Transparency = old end end end
        for l,old in pairs(t.lights) do if l and l.Parent then if d > lightDisableD then l.Enabled = false else l.Enabled = old end end end
    end

    local function processOne(m)
        if not m or not m.Parent then clean(m); return end
        local t = cache[m]; if not t then return end
        local p = t.prim
        if not p or not p.Parent then p = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart"); t.prim = p end
        if not p then return end
        local c = cam()
        if not c or not c.CFrame then return end
        local camPos = c.CFrame.Position
        local d2 = sqrmag(camPos, p.Position)
        t.lastD = math.sqrt(d2)
        if d2 > rd2 then
            if t.lod ~= "low" and t.lod ~= "hidden" then doHideHigh(m,t) end
            applyBudget(t, math.sqrt(d2))
            t.freq = math.min(12, math.max(6, math.floor(math.sqrt(d2) / 300)))
            return
        end
        if d2 > LOD_D2 then
            local occ = cheapOccl(m,t,p,camPos)
            applyBudget(t, math.sqrt(d2))
            if occ and t.lod ~= "low" then doHideHigh(m,t); return end
            if (not occ) and t.lod ~= "high" then doShowHigh(m,t); return end
            t.freq = math.max(2, math.floor(math.sqrt(d2) / 250))
            return
        end
        applyBudget(t, math.sqrt(d2))
        if t.lod ~= "high" then doShowHigh(m,t) end
        t.freq = 0
    end

    local function rebuild()
        local ok,arr = pcall(function() return cs:GetTagged(TAG) end)
        list = {}
        if ok and arr then
            for i=1,#arr do local m = arr[i]; if m and m.Parent then mkc(m); list[#list+1] = m end end
        end
    end

    cs:GetInstanceAddedSignal(TAG):Connect(function(m) if m then mkc(m) end end)
    cs:GetInstanceRemovedSignal(TAG):Connect(function(m) if m then clean(m) end end)

    local function adaptFPS()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastSample >= FPS_SAMPLE then
            avgFPS = frameCount / (now - lastSample)
            frameCount = 0
            lastSample = now
            if avgFPS < TARGET - 6 then
                rd = math.max(RD_MIN, rd * ADAPT)
            elseif avgFPS > TARGET + 6 then
                rd = math.min(RD_DESKTOP, rd / ADAPT)
            end
            rd2 = rd * rd
            local ratio = math.max(0.18, math.min(2.8, avgFPS / math.max(1, TARGET)))
            step = math.max(4, math.floor(BASE_STEP * ratio))
            if debugLog then pcall(function() print("PerfMaster fps", math.floor(avgFPS), "rd", math.floor(rd), "step", step) end) end
            panicMode = avgFPS < PANIC_FPS
            if panicMode then
                rd = math.max(RD_MIN * 0.5, rd * 0.6)
                rd2 = rd*rd
                setmetatable(cache, {__mode="k"})
            end
        end
    end

    local function setShadows(on) pcall(function() if lg then lg.GlobalShadows = on end end) end

    local function warmupFPS()
        local s = tick(); local c = 0; local tot = 0
        while tick() - s < WARMUP_S do
            local a = rs.Heartbeat:Wait()
            c = c + 1
            tot = tot + (1 / math.max(0.0001, a))
        end
        return tot / math.max(1, c)
    end

    local function initProfile()
        detectPlatform()
        local warm = warmupFPS()
        if warm < SHADOWS_OFF_IF_FPS_BELOW then setShadows(false) else setShadows(true) end
        if debugLog then pcall(function() print("PerfMaster warmFPS", math.floor(warm)) end) end
    end

    local function setPerfOn(v)
        perfOn = v and true or false
        if not perfOn then
            rd = RD_DESKTOP; rd2 = rd*rd
            setShadows(true)
            for m,t in pairs(cache) do if m and m.Parent then doShowHigh(m,t) end end
        else
            rd = (us and us.TouchEnabled) and RD_MOBILE or RD_DESKTOP
            rd2 = rd*rd
            task.spawn(initProfile)
        end
        if plr and plr.SetAttribute then pcall(function() plr:SetAttribute(UI_SAVE_KEY, perfOn) end) end
    end

    local function toggleAward()
        awardMode = not awardMode
        if awardMode then
            rd = math.max(RD_MIN, math.floor(rd * AWARDMODE_RD_SCALE))
            rd2 = rd*rd
            setShadows(false)
            particleMax = 8
            for _,m in pairs(cache) do
                for e,_ in pairs(m.emit) do if e and e.Parent then e.Enabled = false end end
            end
        else
            detectPlatform()
            task.spawn(initProfile)
        end
    end

    local function buildUI()
       
    end

    local function loadSaved()
        if plr and plr.GetAttribute then
            local ok, v = pcall(function() return plr:GetAttribute(UI_SAVE_KEY) end)
            if ok and type(v) == "boolean" then perfOn = v else perfOn = true end
        end
    end

    task.spawn(function()
        pcall(initProfile)
        pcall(loadSaved)
        pcall(buildUI)
        rebuild()
        local idx = 1
        local q = {}
        local running = true

        local function worker()
            while running do
                local job = table.remove(q)
                if job then
                    processOne(job)
                else
                    task.wait()
                end
            end
        end

        for i=1,WORKER_POOL do task.spawn(worker) end

        while true do
            raycastsLeft = MAX_RAYCASTS_PER_FRAME
            adaptFPS()
            if not perfOn then
                task.wait()
                rs.Heartbeat:Wait()
                continue
            end

            if #list == 0 then rebuild() end
            local camPos = cam() and cam().CFrame and cam().CFrame.Position or Vector3.new(0,0,0)

            local n = #list
            if n > 0 then
                local sample = math.min(n, step * 3)
                local tmp = alloc()
                for i=1,n do
                    local m = list[i]; local t = cache[m]
                    if t and t.prim then
                        tmp[#tmp+1] = {m = m, d = sqrmag(camPos, t.prim.Position)}
                    end
                end
                table.sort(tmp, function(a,b) return a.d < b.d end)
                for i=1,math.min(#tmp, sample) do q[#q+1] = tmp[i].m end
                free(tmp)
            end

            for i=1, step do
                if #list == 0 then break end
                local m = list[idx]
                if not m or not m.Parent then rebuild(); break end
                local t = cache[m]
                if t then
                    t.ticket = (t.ticket or 0) + 1
                    if t.freq == 0 then q[#q+1] = m
                    else
                        if (t.ticket % (t.freq + 1)) == 0 then q[#q+1] = m end
                    end
                end
                idx = idx + 1
                if idx > #list then idx = 1 end
            end

            local waitAmt = math.max(BATCH_WAIT_MIN, math.min(BATCH_WAIT_MAX, 0.001 * (BASE_STEP / math.max(1, step))))
            task.wait() -- NOTE TO MYSELF: Re add waitAmt if it turns out to make the performance worse.

            if panicMode then
                setShadows(false)
                if not awardMode then
                    particleMax = math.max(6, math.floor(particleMax * 0.45))
                    for m,t in pairs(cache) do
                        for e,_ in pairs(t.emit) do if e and e.Parent then e.Enabled = false end end
                    end
                end
            end

            rs.Heartbeat:Wait()
        end
    end)
end


-- spam limiter bucket
local function trackSpam()
    local cur = tick()
    if cur - t0 > cfg.per then
        t0 = cur
        bucket = 0
    end
    bucket = bucket + 1
    if cfg.spamLimitEnabled and bucket > cfg.cap + cfg.capBurst then
        return false
    end
    return true
end

-- core: build step queue from input queue based on stepCount
local function buildStepQueue(stepCount)
    local nowt = now()
    if cfg.lateCutoff then
        curFrame = nowt
        -- copy everything
        local copy = {}
        for i=1,#q do copy[#copy+1] = q[i] end
        q = {}
        -- create steps
        if first then
            first = false
            lastFrame = curFrame
            return
        end
        local delta = curFrame - lastFrame
        if delta <= 0 then delta = 1 end
        local stepDelta = math.floor(delta / math.max(1, stepCount))
        local idx = 1
        local elapsedFrac = 0
        for s=1, stepCount do
            local elapsed = 0
            while #copy > 0 do
                local front = copy[1]
                local rel = front.time - lastFrame
                if rel < stepDelta * s then
                    local inputTime = ((front.time - lastFrame) % stepDelta) / (stepDelta ~= 0 and stepDelta or 1)
                    local df = math.max(1e-9, math.min(1.0, inputTime - elapsed))
                    sq[#sq+1] = {input = front, deltaFactor = df, endStep = false}
                    table.remove(copy,1)
                    elapsed = inputTime
                else break end
            end
            sq[#sq+1] = {input = {time = 0}, deltaFactor = math.max(1e-9, 1.0 - elapsed), endStep = true}
        end
        lastFrame = curFrame
    else
        curFrame = nowt
        if first then
            first = false
            lastFrame = curFrame
            return
        end
        local copy = {}
        while #q > 0 and q[1].time <= curFrame do
            copy[#copy+1] = q[1]
            table.remove(q,1)
        end
        local delta = curFrame - lastFrame
        if delta <= 0 then delta = 1 end
        local stepDelta = math.floor(delta / math.max(1, stepCount))
        local elapsedFrac = 0
        for s=1, stepCount do
            local elapsed = 0
            while #copy > 0 do
                local front = copy[1]
                local rel = front.time - lastFrame
                if rel < stepDelta * s then
                    local inputTime = ((front.time - lastFrame) % stepDelta) / (stepDelta ~= 0 and stepDelta or 1)
                    local df = math.max(1e-9, math.min(1.0, inputTime - elapsed))
                    sq[#sq+1] = {input = front, deltaFactor = df, endStep = false}
                    table.remove(copy,1)
                    elapsed = inputTime
                else break end
            end
            sq[#sq+1] = {input = {time = 0}, deltaFactor = math.max(1e-9, 1.0 - elapsed), endStep = true}
        end
        lastFrame = curFrame
    end
end

-- pop and process steps
local function popStep()
    if #sq == 0 then return end
    local front = sq[1]
    if front == nil then return end
    if front.input and front.input.time and front.input.time ~= 0 then
        enInput = true
        doAct(front.input)
        enInput = false
    end
    table.remove(sq,1)
end

